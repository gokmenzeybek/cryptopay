{
  "name": "cryptopay-express",
  "version": "3.0.0",
  "description": "CryptoPay Production Server - Enterprise XRPL Payment Application with P2P Exchange",
  "main": "server.production.js",
  "scripts": {
    "start": "node server.production.js",
    "dev": "nodemon server.production.js",
    "build": "react-scripts build",
    "prod": "NODE_ENV=production node server.production.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:api": "node test_api.js",
    "test:prod": "NODE_ENV=production node test_api.js",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:services": "jest services/__tests__",
    "test:middleware": "jest middleware/__tests__",
    "test:components": "jest src/components/__tests__",
    "test:hooks": "jest src/hooks/__tests__",
    "test:server": "jest server/__tests__",
    "test:all": "./scripts/test-all.sh",
    "test:docker": "docker-compose -f docker-compose.test.yml up test-unit",
    "test:docker-coverage": "docker-compose -f docker-compose.test.yml up test-coverage",
    "test:docker-integration": "docker-compose -f docker-compose.test.yml up test-integration",
    "test:docker-dev": "docker-compose -f docker-compose.test.yml up test-dev",
    "db:migrate": "node database/migrate.js",
    "logs": "tail -f logs/combined.log",
    "logs:error": "tail -f logs/error.log",
    "health": "curl -f http://localhost:5001/api/health || exit 1",
    "lint": "eslint src/ server*.js middleware/ services/ database/",
    "lint:fix": "eslint src/ server*.js middleware/ services/ database/ --fix",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "docker:build": "docker build -t cryptopay:latest .",
    "docker:run": "docker run -p 5001:5001 --env-file .env cryptopay:latest",
    "docker:compose": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f",
    "docker:down": "docker-compose down",
    "backup:db": "pg_dump -h $POSTGRES_HOST -U $POSTGRES_USER $POSTGRES_DB > backup_$(date +%Y%m%d_%H%M%S).sql",
    "monitor": "pm2 monit",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop cryptopay",
    "pm2:restart": "pm2 restart cryptopay",
    "pm2:logs": "pm2 logs cryptopay"
  },
  "dependencies": {
    "@papara/papara": "^1.0.4",
    "@vercel/speed-insights": "^2.0.0",
    "@yudiel/react-qr-scanner": "^2.3.1",
    "axios": "^1.3.0",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.8.0",
    "react-toastify": "^9.1.0",
    "ripple-keypairs": "^2.0.0",
    "selfsigned": "^3.0.1",
    "styled-components": "^5.3.6",
    "winston": "^3.18.3",
    "jsonwebtoken": "^9.0.2",
    "xrpl": "^3.0.0",
    "ws": "^8.11.3"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/plugin-proposal-class-properties": "^7.18.0",
    "@babel/plugin-transform-runtime": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@testing-library/jest-dom": "^5.16.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.0",
    "babel-jest": "^29.5.0",
    "concurrently": "^7.6.0",
    "eslint": "^8.57.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "nodemon": "^3.0.1",
    "react-scripts": "5.0.1",
    "supertest": "^6.3.0"
  },
  "keywords": [
    "xrpl",
    "crypto",
    "payment",
    "api",
    "express",
    "qr-scanner"
  ],
  "author": "CryptoPay Team",
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
