# Database Configuration
# Prefer DATABASE_URL for managed Postgres (Supabase/Render/Neon).
# When set, discrete POSTGRES_* vars below are ignored.
# DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=require
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cryptopay
POSTGRES_USER=cryptopay_user
POSTGRES_PASSWORD=your_password_here
# Set true for Supabase / cloud Postgres TLS
POSTGRES_SSL=false

# Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# XRPL Configuration
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
XRPL_MAINNET_URL=wss://xrplcluster.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/combined.log

# Security
CORS_ORIGIN=http://localhost:3000
HELMET_ENABLED=true

# Monitoring
HEALTH_CHECK_INTERVAL=30000

# Papara Configuration
PAPARA_API_KEY=your_papara_api_key_here
PAPARA_ENVIRONMENT=sandbox
PAPARA_MERCHANT_ID=your_merchant_id_here
# HMAC secret for /api/webhooks/papara (REQUIRED in production — no fallback)
PAPARA_WEBHOOK_SECRET=your_papara_webhook_secret_here
# Moderator API key for /api/moderator/* (REQUIRED in production — endpoints
# refuse all requests when this is unset)
MODERATOR_API_KEY=your_moderator_api_key_here

# Two-tier users: burner buyer wallets (services/burnerWalletService.js)
# The platform account that sponsors the base reserve for each guest buyer
# wallet and receives the residual balance on AccountDelete.
SPONSOR_SEED=<seed of the platform account that funds burner reserves>
SPONSOR_ADDRESS=<address of the same account (AccountDelete destination)>
# Sweeper cadence: how often to scan for destroyable burners, and the minimum
# account age before AccountDelete (must clear the ~15 min tecTOO_SOON rule).
BURNER_SWEEP_INTERVAL_MS=60000
BURNER_DESTROY_DELAY_MS=960000        # >= ~15 min (clears tecTOO_SOON)
# Optional:
# MAX_SELLERS=25

# ==============================================================================
# MERGED FROM legacy .env/.env.example (directory removed in PRD Phase 1)
# Only variables actually read by the code were carried over. The legacy
# Stripe/PayPal/MoonPay/PAYMENT_PROVIDER block was dropped: those conversion
# services are removed in PRD Phase 2.
# ==============================================================================

# Rate cache TTL in seconds (default: 300 = 5 minutes)
RATE_CACHE_TTL_SECONDS=300

# Frontend (Create React App — read at build time)
# API base URL for the backend; when unset the app auto-detects from window.location.hostname
# REACT_APP_API_URL=http://localhost:5001
# WebSocket base URL for orderbook/trade updates; when unset it is derived from REACT_APP_API_URL
# REACT_APP_WS_URL=ws://localhost:5001
# XRPL network for the frontend wallet (testnet default; options: testnet, devnet, mainnet)
# REACT_APP_XRPL_NETWORK=testnet

# XRPL Network (default: testnet). Options: testnet, devnet, mainnet
XRPL_NETWORK=testnet

# Per-route rate limit tiers (requests per window)
RATE_LIMIT_EXCHANGE_RATES=60
RATE_LIMIT_PAYMENT_INTENT=10
RATE_LIMIT_CONVERSION=20
RATE_LIMIT_WEBHOOK=100

# CORS allowed origins, comma-separated (this is the variable the code reads;
# CORS_ORIGIN above is reconciled in PRD Phase 5)
CORS_ORIGINS=http://localhost:3000,http://localhost:5001

# Enable detailed request logging (default: false)
LOG_REQUESTS=false
